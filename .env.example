# VocaViz Environment Configuration
# Copy this file to .env and fill in your API key

# Google AI API Key for Gemma
# Get your key from: https://aistudio.google.com/app/apikey
GEMMA_API_KEY=your_api_key_here

# Model to use (options: gemma-2-2b, gemma-3-multimodal)
GEMMA_MODEL=gemma-2-2b

# Inference mode (options: mock, remote, local)
# - mock: Uses predefined results (no API key needed)
# - remote: Uses Google AI API (requires API key)
# - local: Uses on-device model (not yet implemented)
INFERENCE_MODE=mock
