# VocaViz Environment Configuration
# Copy this file to .env and fill in your API key

# Google AI API Key for Gemma
# Get your key from: https://aistudio.google.com/app/apikey
GEMMA_API_KEY=your_api_key_here

# Model to use (options: gemma-2-2b, gemma-4-2b, gemma-4-4b)
# For Gemma 4 Good Hackathon: use gemma-4-2b or gemma-4-4b
GEMMA_MODEL=gemma-4-2b

# Inference mode (options: mock, remote, local)
# - mock: Uses predefined results (no API key needed) - DEFAULT FOR DEMO
# - remote: Uses Google AI API (requires API key)
# - local: Uses on-device Gemma 4 via LiteRT-LM (requires model artifact)
INFERENCE_MODE=mock

# Local model path (for local mode)
# Place your Gemma 4 .litertlm (and companion .bin) in assets/models/
LOCAL_MODEL_PATH=assets/models/gemma4_2b_v09_obfus_fix_all_modalities_thinking.litertlm
